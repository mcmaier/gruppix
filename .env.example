# Copy to .env and fill in. Never commit .env. Keep it UTF-8 (umlauts in regexes).

# --- Host ---
# Where the originals are archived on the host (absolute path, must exist).
# Synology e.g. /volume1/Verein/Fotoarchiv, Linux server e.g. /srv/gruppix-archive
ARCHIVE_PATH=
# WAHA dashboard port: 127.0.0.1 = only via SSH tunnel (server), 0.0.0.0 = LAN (NAS)
WAHA_BIND=127.0.0.1
# Admin portal (quarantine, duplicates, status in the browser; user "admin").
# Empty password = portal off. At least 12 characters. LAN only, never via the router.
ADMIN_PASSWORD=
ADMIN_BIND=127.0.0.1
ADMIN_PORT=8081
# Name of the club as Konzertmeister appends it to titles ("(+) Maifest (<name>)"),
# also shown in Home Assistant. Empty = only the (+)/(-)/(?) prefix is removed.
CLUB_NAME=

# --- WAHA ---
# Also used by the worker to check the WhatsApp session every 15 min
WAHA_API_KEY=change-me-long-random
WAHA_DASHBOARD_PASSWORD=change-me
HOOK_HMAC_KEY=change-me-long-random

# --- Source ---
# The one group whose media is taken over (…@g.us). Shown under "webhooks.groups"
# in /health as soon as a message arrives there. Test group first, the real group at go-live.
GROUP_CHAT_ID=
# Development: record raw webhooks of GROUP_CHAT_ID to data/worker/webhook-capture/
# (max. 500 files, includes texts of that group). Switch off again afterwards.
WEBHOOK_CAPTURE=off
# Phase 2: take over photos/videos of GROUP_CHAT_ID live, 📸 = into the gallery,
# ❌ (by sender or group admin) and "delete for everyone" = remove everywhere.
LIVE_INGEST=off
# One bot message per event in the group once its folder has ANNOUNCE_MIN_ITEMS
# photos (live only, never for imports or events older than ANNOUNCE_MAX_AGE_DAYS).
# No messages during ANNOUNCE_QUIET_HOURS (sent when they end; "-" = none).
ANNOUNCE=off
# Link to an event folder inside the members' share; {path} = "/2026/2026-07-11 Sommerfest".
# Nextcloud share links use ?dir=, e.g. https://cloud.example/s/TOKEN?dir={path}
# (open a subfolder of the share in a browser to confirm the parameter name).
GALLERY_FOLDER_URL=
ANNOUNCE_MIN_ITEMS=5
ANNOUNCE_QUIET_HOURS=22-9
ANNOUNCE_MAX_AGE_DAYS=3
# Placeholders {title} {folder} {count} {link}; \n = line break
#ANNOUNCE_TEXT=📸 Neu in der Galerie: „{title}“ mit {count} Bildern\n{link}\nHabt ihr noch mehr? Einfach hier posten, für volle Qualität als Dokument.
# Salt for hashing senders (never store phone numbers or names in plain text).
# Do not change it later, otherwise opt-outs and batches no longer match.
SENDER_SALT=change-me-long-random

# --- Calendars (comma-separated, first source wins on duplicates) ---
# 1. Google: Settings → "Secret address in iCal format"   (nicer public titles)
# 2. Konzertmeister: iCal subscription of an account invited to all events
CALENDAR_ICS_URLS=
# Events matching this regex never open a photo window
EVENT_EXCLUDE_REGEX=(?i)((musik|gesamt|satz|theater|anspiel)probe|\bprobe\b|beerdigung|sitzung|vorstand)
# Removed from event titles before they become folder names. Default handles
# Konzertmeister with CLUB_NAME: "(+) Maifest (<CLUB_NAME>)" -> "Maifest".
# Leave the line out for the default; set it empty to disable.
#EVENT_TITLE_STRIP_REGEX=^\s*\([+\-?]\)\s*|\s*\(Mein Verein e\. V\.\)\s*$
# Build-up/tear-down within SIDE_EVENT_GAP_HOURS of another event are merged
# into it ("Aufbau" Fri + "Heckenfest" Sat + "Abbau" Sun -> one folder "Heckenfest").
# Without a neighbouring event they keep their own folder. Default: Aufbau|Abbau.
#EVENT_SIDE_REGEX=(?i)(auf|ab)bau
SIDE_EVENT_GAP_HOURS=24
# All-day entries run from DAY_CUTOFF_HOUR to DAY_CUTOFF_HOUR next morning;
# longer than this many days (holidays) they are ignored. 0 = no limit.
ALL_DAY_MAX_DAYS=4
WINDOW_PRE_HOURS=4
WINDOW_POST_HOURS=36
# Photos without capture time posted later than WINDOW_POST_HOURS:
# assigned to the last event within LATE_GRACE_DAYS, but only as a batch
# (>= LATE_MIN_BATCH items from one sender, gaps <= LATE_BATCH_GAP_MINUTES)
LATE_GRACE_DAYS=4
LATE_MIN_BATCH=3
LATE_BATCH_GAP_MINUTES=10
# Day boundary (photos after midnight belong to the evening before): folder
# dates of clusters, all-day events, admin command "Ordner heute"
DAY_CUTOFF_HOUR=6

# --- Quarantine (photos outside every event) ---
QUARANTINE_DAYS=14
# An event folder is created only from this many items on; until then they
# are held, and go to quarantine if the event stays below it (1 = off).
# Photographer uploads and items marked with 📸 always count.
MIN_EVENT_ITEMS=3
# Burst without calendar entry → admin inbox "YYYY-MM-DD Unbenannt"
CLUSTER_MIN_ITEMS=6
CLUSTER_MIN_SENDERS=2
CLUSTER_MAX_GAP_HOURS=4

# --- Nextcloud (dedicated user "fotobot", app password) ---
NC_WEBDAV_URL=https://cloud.example.de/remote.php/dav/files/fotobot
NC_USER=fotobot
NC_APP_PASSWORD=
# Gallery: shared with members (password-protected link)
NC_GALLERY_DIR=Fotos
# Inbox: NOT shared, admin review of untitled clusters
NC_INBOX_DIR=Fotos-Eingang
# Upload folder for photographers (password link, upload + edit, no delete)
NC_DROP_DIR=Fotos-Upload
# A folder is collected once no new file arrived for this many minutes
DROP_QUIET_MINUTES=10

# --- Service (built-in scheduler, replaces DSM task scheduler) ---
DROP_INTERVAL_MINUTES=15
RETRY_INTERVAL_MINUTES=60
# Hour (0-23) for daily maintenance: purge quarantine, move clusters to inbox
MAINTENANCE_HOUR=4

# --- Processing ---
IMG_MAX_EDGE=2048
IMG_MAX_BYTES=1000000
IMG_JPEG_QUALITY=85
VIDEO_MAX_EDGE=1280
VIDEO_MAX_SECONDS=180
# Longer videos: original archived, converted copy goes to the admin inbox
# (Fotos-Eingang, same folders) up to this length; beyond, archive only.
VIDEO_INBOX_MAX_SECONDS=1800
# Clips up to this length (Live/Motion photos) become a still photo in the photo
# timeline; the clip is archived next to it. 0 = keep them as videos.
CLIP_AS_PHOTO_SECONDS=3
VIDEO_CRF=26

# --- Notifications (all optional; empty = log only) ---
# Alerts are sent once when a problem appears and once when it is resolved.
# Home Assistant via MQTT: entities appear automatically (MQTT discovery).
# MQTT_HOST = LAN address of the broker, not localhost (container!)
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=gruppix
# E-mail: same account as DSM notifications, or a club mailbox at the web host
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587) | ssl (port 465) | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated; ideally a second admin too
SMTP_TO=
# Dead man's switch: healthchecks.io check URL (period 15 min, grace 30 min)
HEALTHCHECK_PING_URL=
# Weekly report: weekday 0 = Monday … 6 = Sunday, -1 = off
REPORT_WEEKDAY=6
REPORT_HOUR=18
# Warn when free space drops below (GB)
MIN_FREE_GB_NAS=5
MIN_FREE_GB_NEXTCLOUD=2
